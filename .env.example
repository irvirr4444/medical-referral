# Copy to .env and fill in locally
ANTHROPIC_API_KEY=
# Highest-accuracy native-PDF extraction defaults (optional overrides)
ANTHROPIC_PDF_MODEL=claude-opus-5
ANTHROPIC_PDF_EFFORT=max
ANTHROPIC_PDF_MAX_TOKENS=32000
# Primary transport. Set to inline only when Files API is unavailable.
ANTHROPIC_PDF_TRANSPORT=files-api

MONDAY_DOT_COM_API_KEY=

# Read-only Microsoft Graph intake poller. Use a dedicated test mailbox first.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=

# Shared DRK EMR credentials (used by read_patient and create_patient)
EMR_URL=
EMR_USERNAME=
EMR_PASSWORD=

# --- read_patient only ---
# Preferred: open patient by name via dashboard search (First Last)
TEST_PATIENT_NAME=
# Optional fallback if TEST_PATIENT_NAME is empty
TEST_PATIENT_ID=

# See also:
#   src/drk_emr/read_patient/.env.example
#   src/drk_emr/create_patient/.env.example
