# Copy to .env and fill in locally
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Used only for ambiguous natural-language confirmation replies.
OPENAI_CONFIRMATION_MODEL=gpt-4.1-mini
# Highest-accuracy native-PDF extraction defaults (optional overrides)
ANTHROPIC_PDF_MODEL=claude-opus-5
ANTHROPIC_PDF_FALLBACK_MODELS=claude-opus-4-8
ANTHROPIC_PDF_EFFORT=max
ANTHROPIC_PDF_MAX_TOKENS=32000
# Primary transport. Set to inline only when Files API is unavailable.
ANTHROPIC_PDF_TRANSPORT=files-api

# Durable intake retry / Anthropic circuit defaults (optional)
INTAKE_MAX_ATTEMPTS=5
INTAKE_ANTHROPIC_CIRCUIT_FAILURES=3
INTAKE_ANTHROPIC_CIRCUIT_COOLDOWN_SECONDS=900

OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=
# Required when review emails are enabled. Must be an authorized internal intake-team address.
REVIEW_RECIPIENT_EMAIL=

# Durable review correlation and JSON snapshots (backend only).
REFERRAL_REVIEW_STORE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Remote referral persistence is fail-closed. Only PDF hashes in this generated
# synthetic dataset manifest may be written to Supabase.
SYNTHETIC_DATASET_MANIFEST=output/pdf/synthetic-referrals/dataset.json

MONDAY_DOT_COM_API_KEY=

# Workflow database. Keep the service-role key server-side and out of Git.
# Use sqlite for local rehearsals; use supabase only after applying the migration.
WORKFLOW_DATABASE_BACKEND=sqlite
WORKFLOW_SQLITE_PATH=tmp/workflow-monitor.sqlite

# Stage 1 outbound acknowledgement and DRK duplicate lookup are explicit opt-ins.
# Leave both false until the destination mailbox and DRK account are approved for the test.
INTAKE_PARTNER_ACKNOWLEDGEMENT_ENABLED=false
INTAKE_STAGE_ONE_DRK_CHECK_ENABLED=false

# Step 4-5 business rules and alert routing.
WCW_TIMEZONE=America/Los_Angeles
WCW_END_OF_DAY=17:00
WCW_NOT_SEEN_REVIEW_THRESHOLD=3
WORKFLOW_NOTIFICATION_RECIPIENTS=

# DRK read-only browser credentials. Live mode requires an authorized account.
EMR_URL=
EMR_USERNAME=
EMR_PASSWORD=
DRK_LIVE_HEADLESS=true
DRK_LIVE_PAGE_TIMEOUT_SECONDS=30
DRK_LIVE_NETWORK_IDLE_SECONDS=2.5

# Optional continuous worker defaults (Render background worker / run_worker.py)
# INTAKE_DATA_ROOT=/var/data/intake
# INTAKE_POLL_INTERVAL_SECONDS=600
# INTAKE_RETRY_INTERVAL_SECONDS=300
# INTAKE_APPROVAL_INTERVAL_SECONDS=60
# INTAKE_MAX_MESSAGES=25
# INTAKE_MAX_RETRY_JOBS=10
# INTAKE_MAX_APPROVAL_MESSAGES=100
# Workers check replies only by default. This enables no-write validation.
# INTAKE_DRY_RUN_APPROVALS=false
# The local `inbox-api` UI controller defaults to OFF. Use --start-monitor only
# when the testing infobox should begin processing immediately.
# Real Monday writes are available only through: run_pipeline.py approvals --execute
# INTAKE_MONITOR_ENABLED=false
# INTAKE_MONITOR_INTERVAL_SECONDS=3600
# INTAKE_MONITOR_SEND_ALERTS=false
# Keep false until the worker host has Chrome and linked DRK patient IDs.
# INTAKE_LIVE_DRK_ENABLED=false
# INTAKE_DRK_MAX_PATIENTS_PER_CYCLE=10
# PHI-free cycle health is on by default; transition emails remain off by default.
# INTAKE_HEALTH_ENABLED=true
# INTAKE_HEALTH_FAILURE_THRESHOLD=3
# INTAKE_HEALTH_SEND_ALERTS=false

# Gmail SLA alerts. OAuth is preferred; SMTP app credentials are a fallback.
# Per-case CM/provider addresses come from workflow state. Organization-level
# roles use one JSON value, for example:
# {"intake_lead":["intake@example.com"],"management":["manager@example.com"],"scheduling_lead":["scheduling@example.com"]}
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ALERT_USER=
GMAIL_ALERT_APP_PASSWORD=
GMAIL_ALERT_FROM=
GMAIL_ALERT_APP_BASE_URL=http://localhost:5173
GMAIL_ALERT_ROLE_EMAILS={}
# Test only: overrides every To/Cc destination with this controlled inbox.
GMAIL_ALERT_DEFAULT_TO=

# De-identification pipeline (deidentify_patient_docs.py)
ANTHROPIC_DEID_MODEL=claude-sonnet-5
