# Copy to .env and fill in locally
ANTHROPIC_API_KEY=
# Highest-accuracy native-PDF extraction defaults (optional overrides)
ANTHROPIC_PDF_MODEL=claude-opus-5
ANTHROPIC_PDF_FALLBACK_MODELS=claude-opus-4-8
ANTHROPIC_PDF_EFFORT=max
ANTHROPIC_PDF_MAX_TOKENS=32000
# Primary transport. Set to inline only when Files API is unavailable.
ANTHROPIC_PDF_TRANSPORT=files-api

# Durable intake retry / Anthropic circuit defaults (optional)
INTAKE_MAX_ATTEMPTS=5
INTAKE_ANTHROPIC_CIRCUIT_FAILURES=3
INTAKE_ANTHROPIC_CIRCUIT_COOLDOWN_SECONDS=900

OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=
REVIEW_RECIPIENT_EMAIL=

MONDAY_DOT_COM_API_KEY=

# Optional continuous worker defaults (Render background worker / run_worker.py)
# INTAKE_DATA_ROOT=/var/data/intake
# INTAKE_POLL_INTERVAL_SECONDS=600
# INTAKE_RETRY_INTERVAL_SECONDS=300
# INTAKE_MAX_MESSAGES=25
# INTAKE_MAX_RETRY_JOBS=10
